# Copy to .env and set your own values. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=4321
CALENDAR_DEMO_REMOTE=1
CALENDAR_PUBLIC_DEMO=0
CALENDAR_SHARED_CALENDAR=0
CALENDAR_DATABASE_PATH=./data/calendar.sqlite
CALENDAR_EXPERIMENT=local
# Generate at least 32 random characters; no working token is included.
CALENDAR_EXPERIMENT_TOKEN=
CALENDAR_SYNC_INTERVAL_MS=60000
CALENDAR_BACKUP_DIR=./backups
CALENDAR_BACKUPS_KEEP=14
