# Copy to .env and set your own values. Never commit .env.
NODE_ENV=production
# 127.0.0.1 behind a local reverse proxy (nginx); 0.0.0.0 only when clients or the proxy connect from another machine.
HOST=0.0.0.0
PORT=4321
CALENDAR_ALLOW_REMOTE=1
# 1 = admin open without login (current decision until Telegram login). 0 = secret link only.
CALENDAR_ADMIN_OPEN=1
# Use an absolute path on a persistent disk in production.
CALENDAR_DATABASE_PATH=./data/calendar.sqlite
CALENDAR_EXPERIMENT=local
# Generate at least 32 random characters; no working token is included.
CALENDAR_EXPERIMENT_TOKEN=
CALENDAR_SYNC_INTERVAL_MS=60000
# Optional write-back to Google Calendar (service account key file; requires CALENDAR_ADMIN_OPEN=0).
# GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/service-account.json
CALENDAR_BACKUP_DIR=./backups
CALENDAR_BACKUPS_KEEP=14
